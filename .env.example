# Copier vers .env; ne jamais versionner la clé.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna
HYDRO_DATA_DIR=data
# Identifiants du conteneur local Compose; remplacer pour une base distante.
HYDRO_DATABASE_URL=postgresql://hydro:hydro-local@127.0.0.1:55432/hydro
HYDRO_MAX_STEPS=24
HYDRO_TRACE_PATH=.hydro/traces.jsonl
# Facultatif : URL d’un collecteur OTLP HTTP; aucun export cloud par défaut.
HYDRO_OTLP_ENDPOINT=
HYDRO_ANALYTICS_BACKEND=json
# Facultatif : workspace et service de modèle Databricks réellement déployé.
DATABRICKS_SERVING_ENDPOINT=
DATABRICKS_TOKEN=
# Identité locale simulée, choisie par l’hôte et jamais par le modèle.
HYDRO_ACTOR=operateur-local
HYDRO_ROLE=operator
# Foundry : connexion avec az login, sans clé Azure.
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT=hydro-gpt-5-mini-poc
AZURE_AI_AGENT_NAME=hydro-investigator
# Renseigner la version retournée par uv run hydro-agent publish-foundry.
AZURE_AI_AGENT_VERSION=
# Recherche : local hors ligne, azure après création Search Free et indexation.
HYDRO_SEARCH_BACKEND=local
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=procedures-v1
