# Copier vers .env; ne jamais versionner la clé.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
HYDRO_DATA_DIR=data
HYDRO_DB_PATH=.hydro/incidents.sqlite3
HYDRO_MAX_STEPS=24
# Identité locale simulée, choisie par l’hôte et jamais par le modèle.
HYDRO_ACTOR=operateur-local
HYDRO_ROLE=operator
# Réservés à la phase 3 : aucune ressource Azure créée ici.
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT=
